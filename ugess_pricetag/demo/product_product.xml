<odoo>

    <record model="product.product" id="demo_product_A">
        <field name="name">Demo Ugess Product A</field>
        <field name="print_category_id" ref="print_category_ugess_1" />
        <field name="barcode">3380380076619</field>
        <field name="supplier_id" ref="supplier_1" />
        <field
            name="product_tag_ids"
            eval="[
                        (4, ref('ugess_pricetag.product_tag_1')),
                    ]"
        />
    </record>

    <record model="product.product" id="demo_product_B">
        <field
            name="name"
        >Demo Ugess Product B and very long long name and a lot of text</field>
        <field name="print_category_id" ref="print_category_ugess_1" />
        <field name="barcode">3286151030203</field>
        <field name="supplier_id" ref="supplier_2" />
        <field
            name="product_tag_ids"
            eval="[
                        (4, ref('ugess_pricetag.product_tag_1')),
                        (4, ref('ugess_pricetag.product_tag_2')),
                    ]"
        />
    </record>

    <record
        model="product.product"
        id="ugess_pricelist.demo_product_with_specific_prices"
    >
        <field name="print_category_id" ref="print_category_ugess_1" />
        <field name="supplier_id" ref="supplier_2" />
        <field
            name="product_tag_ids"
            eval="[
                        (4, ref('ugess_pricetag.product_tag_2')),
                    ]"
        />
    </record>

</odoo>
