<odoo>
    <record id="view_acquisition_medium_form" model="ir.ui.view">
        <field name="name">res.partner.acquisition.medium.form</field>
        <field name="model">res.partner.acquisition.medium</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_acquisition_medium_tree" model="ir.ui.view">
        <field name="name">res.partner.acquisition.medium.tree</field>
        <field name="model">res.partner.acquisition.medium</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="action_acquisition_medium" model="ir.actions.act_window">
        <field name="name">acquisition.mediums</field>
        <field name="res_model">res.partner.acquisition.medium</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_acquisition_medium"
        name="acquisition.mediums"
        parent="contacts.res_partner_menu_config"
        action="action_acquisition_medium"
    />

</odoo>
