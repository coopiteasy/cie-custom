<odoo>
    <record id="view_partner_form_customer_type" model="ir.ui.view">
        <field name="name">res.partner.form.customer.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <field name="customer_type_id" />
                <field name="acquisition_medium_id" />
            </group>
        </field>
    </record>

    <record id="view_res_partner_filter_customer_type" model="ir.ui.view">
        <field name="name">res.partner.search.customer.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field
                    name="customer_type_id"
                    string="Customer Type"
                    filter_domain="[('customer_type_id.name', 'ilike', self)]"
                />
                <field
                    name="acquisition_medium_id"
                    string="Acquisition Medium"
                    filter_domain="[('acquisition_medium_id.name', 'ilike', self)]"
                />
            </field>
        </field>
    </record>
</odoo>
