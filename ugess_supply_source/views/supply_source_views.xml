<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<record id="supply_source_view_tree" model="ir.ui.view">
    <field name="model">supply.source</field>
    <field name="arch" type="xml">
        <tree name="label">
            <field name="name" />
        </tree>
    </field>
</record>

<record id="supply_source_view_form" model="ir.ui.view">
    <field name="model">supply.source</field>
    <field name="arch" type="xml">
        <form string="Label">
            <field name="name" />
        </form>
    </field>
</record>

<record id="supply_source_view_search" model="ir.ui.view">
    <field name="model">supply.source</field>
    <field name="arch" type="xml">
        <search string="Label">
            <field name="name" />
        </search>
    </field>
</record>

<record model="ir.actions.act_window" id="supply_source_action">
    <field name="name">Label</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">supply.source</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="supply_source_view_search" />
    <field name="domain">[]</field>
    <field name="context">{}</field>
</record>

<menuitem
        id="supply_source_menu"
        name="Supply sources"
        parent="stock.menu_product_in_config_stock"
        sequence="20"
        groups="stock.group_stock_manager,stock.group_stock_user"
        action="supply_source_action"
    />

</odoo>
