<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <page name='personal_information_page' position="after">
                <page
                    string="Social Project"
                    name="social_project"
                    attrs="{'invisible': [('is_company', '=', True)]}"
                    groups="ugess_partner_social_project.group_ugess_partner_social_project_user"
                >
                <group string="Social Project" name="social_project" />
                <field name="social_project_ids">
                        <tree name="social_project" editable="bottom">
                            <field name="type_id" />
                            <field name="start_date" />
                            <field name="realization_rate" />
                            <field name="end_date" />
                            <field name="name" />
                            <field name="comment" />
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>


</odoo>
