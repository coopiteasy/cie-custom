<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Note : group_membership_user implies
    account.group_account_user which in turn implies account.group_account_invoice
    -->

    <record id="role_ugess_cashier" model="res.users.role">
        <field name="name">UGESS Cashier</field>
        <field
            name="implied_ids"
            eval="[
            Command.set([
                ref('base.group_user'),
                ref('point_of_sale.group_pos_user'),
                ref('sales_team.group_sale_salesman_all_leads'),
                ref('ugess_security.group_membership_user'),
                ref('base.group_partner_manager'),
                ref('document_knowledge.group_document_user'),
            ]),
        ]"
        />
    </record>

    <record id="role_ugess_grocer" model="res.users.role">
        <field name="name">UGESS Grocer</field>
        <field
            name="implied_ids"
            eval="[
            Command.set([
                ref('ugess_security.role_ugess_cashier_res_groups'),
                ref('ugess_security.group_res_partner_archive'),
                ref('base.group_allow_export'),
                ref('stock.group_stock_manager'),
                ref('barcodes_generator_abstract.generate_barcode'),
                ref('hr.group_hr_user'),
                ref('purchase.group_purchase_manager'),
                ref('analytic.group_analytic_accounting'),
            ]),
        ]"
        />
    </record>

    <record id="role_ugess_social" model="res.users.role">
        <field name="name">UGESS Social</field>
        <field
            name="implied_ids"
            eval="[
            Command.set([
                ref('ugess_security.role_ugess_grocer_res_groups'),
                ref('ugess_partner_household.group_ugess_partner_household_user'),
                ref('ugess_partner_revenue.group_ugess_partner_revenue_user'),
                ref('ugess_partner_social_project.group_ugess_partner_social_project_user'),
                ref('sql_request_abstract.group_sql_request_user'),
            ]),
        ]"
        />
    </record>

    <record id="role_ugess_manager" model="res.users.role">
        <field name="name">UGESS Manager</field>
        <field
            name="implied_ids"
            eval="[
            Command.set([
                ref('ugess_security.role_ugess_social_res_groups'),
                ref('membership_extension.group_membership_manager'),
                ref('ugess_security.group_res_district_manager'),
            ]),
        ]"
        />
    </record>

</odoo>
