<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
    >
    <!-- Soft replacing purchase UoM without using xpath replace -->
    <xpath expr="//span[@t-field='line.product_qty']/.." position="attributes">
        <attribute name="t-if">False</attribute>
    </xpath>
    <xpath expr="//span[@t-field='line.product_qty']/.." position="after">
        <td class="text-end">
            <span t-field="line.product_main_uom_qty" />
        </td>
    </xpath>
    <!-- Hide the column for taxes -->
    <xpath expr="//th[@name='th_taxes']" position="attributes">
        <attribute name="t-if">False</attribute>
    </xpath>
    <xpath expr="//td[@name='td_taxes']" position="attributes">
        <attribute name="t-if">False</attribute>
    </xpath>
    <!-- Add Units before the date -->
    <xpath expr="//th[@name='th_date_req']" position="before">
        <th name="th_units" class="text-center"><strong>Units per Qty</strong></th>
    </xpath>
    <xpath expr="//span[@t-field='line.date_planned']/.." position="before">
        <td class="text-center">
            <span t-field="line.product_id.uom_id.name" groups="uom.group_uom" />
        </td>
    </xpath>

</template>
</odoo>
