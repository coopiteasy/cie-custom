<odoo>
    <record
        id="beesdoo_product_label_product_template_only_form_view"
        model="ir.ui.view"
    >
        <field name="name">product.template.product.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="beesdoo_product_label.product_view_form" />
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <button
                    string="Nouveau numéro PP"
                    name="generate_ref_code_pp"
                    type="object"
                    colspan="2"
                    attrs="{'invisible' : [('to_weight','=',False)]}"
                />
                <button
                    string="Nouveau numéro producteurs BIO"
                    name="generate_ref_code_bio_producer"
                    type="object"
                    colspan="2"
                    attrs="{'invisible' : [('to_weight','=',False)]}"
                />
                <button
                    string="Nouveau numéro fournisseurs BIO"
                    name="generate_ref_code_bio_supplier"
                    type="object"
                    colspan="2"
                    attrs="{'invisible' : [('to_weight','=',False)]}"
                />
                <button
                    string="Nouveau numéro non-BIO"
                    name="generate_ref_code_non_bio"
                    type="object"
                    colspan="2"
                    attrs="{'invisible' : [('to_weight','=',False)]}"
                />
                <button
                    string="Nouveau numéro non-alimentaire"
                    name="generate_ref_code_non_food"
                    type="object"
                    colspan="2"
                    attrs="{'invisible' : [('to_weight','=',False)]}"
                />
            </field>
            <field name="origin_label" position="after">
                <field name="is_foodprint_label" />
                <field name="is_gentle_price_label" />
            </field>
        </field>
    </record>

    <record
        id="barcodes_generator_product_product_template_only_form_view"
        model="ir.ui.view"
    >
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="barcodes_generator_product.view_product_template_form"
        />
        <field name="arch" type="xml">
            <field name="barcode_rule_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>

    <record id="barcodes_generator_product_product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field
            name="inherit_id"
            ref="barcodes_generator_product.view_product_product_form"
        />
        <field name="arch" type="xml">
            <field name="barcode_rule_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>

</odoo>
