<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_order_product_pivot" model="ir.ui.view">
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot" />
        <field name="arch" type="xml">
            <!-- remove declared (in xml) fields -->
            <field name="price_subtotal" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="price_subtotal" position="after">
                <!-- New measure (default) -->
                <field name="weight" type="measure" />
                <!-- remove non declared (in xml) fields -->
                <field name="untaxed_amount_to_invoice" invisible="1" />
                <field name="untaxed_amount_invoiced" invisible="1" />
                <field name="qty_to_invoice" invisible="1" />
                <field name="qty_invoiced" invisible="1" />
                <field name="qty_to_deliver" invisible="1" />
                <field name="volume" invisible="1" />
            </field>
        </field>
    </record>

    <record id="view_order_product_search" model="ir.ui.view">
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search" />
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="supply_source_id" />
                <field name="supplier_id" />
            </field>
            <filter name="status" position="after">
                <filter
                    string="Non membership sales"
                    name="non_membership_products"
                    domain="[['product_id.membership_category_id', '=', False]]"
                />
                <filter
                    string="Beneficiary"
                    name="beneficiary"
                    domain="[['membership_category_id.ugess_type', '=','beneficiary']]"
                />
                <filter
                    string="Supply source"
                    name="supply_source"
                    context="{'group_by':'supply_source_id'}"
                />
                <filter
                    string="Supplier"
                    name="supplier"
                    context="{'group_by':'supplier_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="sale.action_order_report_all" model="ir.actions.act_window">
        <field name="view_mode">pivot,graph</field>
        <field
            name="context"
        >{'search_default_Sales':1, 'search_default_non_membership_products': 1, 'group_by_no_leaf':1,'group_by':[]}</field>
    </record>

</odoo>
