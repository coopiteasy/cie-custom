<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="lpcr_donation_tax_receipt_document"
        inherit_id="donation_base.report_donationtaxreceipt_document"
    >
        <xpath expr="//t[@t-call='web.internal_layout']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//t[@t-call='web.internal_layout']" position="after">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Reçu fiscal pour don</h2>

                    <p>
                        Reçu au titre de dons à certains organismes d’intérêt
                        général (Art. 200, 238 bis et 978 du code général
                        des impôts (CGI)).
                    </p>

                    <p>
                        <strong>Objet :</strong>
                        Cette association a pour objet la réalisation d’une
                        mission d’intérêt général à caractère social, par
                        la création et l’animation d’activités au service
                        des liens de proximité, dans le but de lutter
                        contre les phénomènes d’isolement et d’anonymat.
                    </p>

                    <p>
                        <strong>No d’ordre de reçu :</strong>
                        <span t-field="o.number" />
                    </p>

                    <p>
                        <strong>Donateur :</strong>
                        <div
                            t-field="o.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
                            class="mb-2"
                        />
                    </p>

                    <p>
                        <strong>Bénéficiaire :</strong>
                        <span t-field="o.company_id" /> reconnait avoir
                        reçu, au titre de versements ouvrant droit à une
                        réduction d’impôt, la somme de
                        <span t-field="o.amount" />.
                    </p>

                    <p>
                        <strong>Date du reçu :</strong>
                        <span t-field="o.date" />
                    </p>

                    <p>
                        <strong>Forme du don :</strong>
                        Déclaration de don manuel
                    </p>

                    <p>
                        <strong>Dons :</strong>
                        <ul>
                            <li t-foreach="o.donation_ids" t-as="donation_id">
                                <span t-field="donation_id.donation_date" />,
                                <span t-field="donation_id.amount_total" />,
                                <span
                                    t-if="donation_id.payment_mode_id"
                                    t-field="donation_id.payment_mode_id"
                                />
                            </li>
                        </ul>
                    </p>

