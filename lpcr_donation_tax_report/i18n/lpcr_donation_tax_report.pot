"                        indirecte, conformément aux dispositions des\n"
"                        articles 200 et 238 bis du Code Général des Impôts."
msgstr ""

#. module: lpcr_donation_tax_report
#: model_terms:ir.ui.view,arch_db:lpcr_donation_tax_report.lpcr_donation_tax_receipt_document
