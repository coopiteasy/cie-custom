<odoo>

    <record model="ir.ui.view" id="lpcr_donation_tax_receipt_form">
        <field name="name">lpcr.donation.tax.receipt.form</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="donor_name" />
                <label for="street" string="Address" />
                <div class="o_address_format">
                    <field name="street" class="o_address_street" />
                    <field name="street2" class="o_address_street" />
                    <field name="city" class="o_address_city" />
                    <field name="state_id" class="o_address_state" />
                    <field name="zip" class="o_address_zip" />
                    <field name="country_id" class="o_address_country" />
                </div>
                <field t-if="siret" name="siret" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="lpcr_donation_tax_receipt_tree">
        <field name="name">lpcr.donation.tax.receipt.tree</field>
        <field name="model">donation.tax.receipt</field>
        <field name="inherit_id" ref="donation_base.donation_tax_receipt_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="email" />
            </field>
        </field>

    </record>
</odoo>
