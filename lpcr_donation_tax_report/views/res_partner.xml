<odoo>
    <record id="lpcr_res_partner_view_search" model="ir.ui.view">
        <field name="name">lpcr.res.partner.search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="donation_base.res_partner_view_search" />
        <field name="arch" type="xml">
            <search>
                <filter
                    name="valid_donors"
                    string="Valid donors"
                    domain="[('is_address_valid','=', True)]"
                />
                <filter
                    name="invalid_donors"
                    string="Invalid donors"
                    domain="[('is_address_valid','=', False)]"
                />
            </search>
        </field>
    </record>
</odoo>
