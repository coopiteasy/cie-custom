<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="ActionpadWidget"
        t-inherit="point_of_sale.ActionpadWidget"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath
            expr="div[hasclass('actionpad')]/button[hasclass('set-partner')]//i[@title='Customer']"
            position="attributes"
        >
            <attribute name="t-attf-class" />
            <attribute
                name="t-attf-class"
                add="
                {{
                    props.partner and
                    (
                        (env.pos.isMembershipEnding(props.partner) and 'membership-orange') or
                        (props.partner.is_member and 'membership-green') or
                        'membership-red'
                    ) or
                    ''
                }}"
                separator=" "
            />
        </xpath>
        <xpath
            expr="div[hasclass('actionpad')]//div[hasclass('membership-info')]"
            position="attributes"
        >
            <attribute name="t-if" />
        </xpath>
    </t>

</templates>
