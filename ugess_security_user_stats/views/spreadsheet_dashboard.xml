<odoo>

    <!-- add some security here to hide the unecessary menus to our
    internal users (that should only have access to anonymous sql reports)
    -->
    <record
        id="spreadsheet_dashboard.spreadsheet_dashboard_menu_dashboard"
        model="ir.ui.menu"
    >
        <field
            name="groups_id"
            eval="[
                Command.link(ref('ugess_security_user_stats.group_user_all_non_private_contacts')),
            ]"
        />
    </record>
    <record
        id="spreadsheet_dashboard.spreadsheet_dashboard_menu_configuration"
        model="ir.ui.menu"
    >
        <field
            name="groups_id"
            eval="[
                Command.link(ref('ugess_security_user_stats.group_user_all_non_private_contacts')),
            ]"
        />
    </record>

</odoo>
