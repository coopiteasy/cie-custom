<templates id="template" xml:space="preserve">

    <t
        t-name="PaymentScreen"
        t-inherit="point_of_sale.PaymentScreen"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[@class='partner-button']" position="after">
            <div class="button">
                <i class="fa fa-user" role="img" />
                <span>
                    <t t-esc="remainingExpenditureAmountText" />
                </span>
            </div>
            <div class="button">
                <i class="fa fa-user" role="img" />
                <span>
                    <t t-esc="remainingExpenditureUntilText" />
                </span>
            </div>
        </xpath>
    </t>

</templates>
