<templates id="template" xml:space="preserve">

    <t
        t-name="OrderSummary"
        t-inherit="point_of_sale.OrderSummary"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[@t-if='_tax.hasTax']" position="after">
            <t
                t-set="_expenditure_ceiling_current"
                t-value="props.order.get_expenditure_ceiling_current()"
            />
            <t
                t-set="_remaining_expenditure_amount"
                t-value="props.order.get_remaining_expenditure_amount()"
            />
            <div t-if="_expenditure_ceiling_current" class="subentry">
                <span>
                    Ceiling:
                    <t t-esc="env.pos.format_currency(_expenditure_ceiling_current)" />
                </span>
                /
                <span t-if="_remaining_expenditure_amount &gt;= 0">
                    To consume:
                    <t t-esc="env.pos.format_currency(_remaining_expenditure_amount)" />
                </span>
                <span
                    t-if="_remaining_expenditure_amount &lt; 0"
                    class="negative-remaining-expenditure-amount"
                >
                    Surplus:
                    <t t-esc="env.pos.format_currency(_remaining_expenditure_amount)" />
                </span>
            </div>
        </xpath>
    </t>

</templates>
