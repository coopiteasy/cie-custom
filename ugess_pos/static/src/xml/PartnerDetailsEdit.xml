<templates id="template" xml:space="preserve">

    <t
        t-name="PartnerDetailsEdit"
        t-inherit="point_of_sale.PartnerDetailsEdit"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//select[@name='country_id']/.." position="after">
            <div
                class="partner-detail"
                t-if="props.partner.expenditure_ceiling_current"
            >
                <span class="label">Ceiling</span>
                    <input
                    class="detail"
                    readonly="readonly"
                    t-att-value="env.pos.format_currency(props.partner.expenditure_ceiling_current)"
                />
            </div>
            <div
                class="partner-detail"
                t-if="props.partner.expenditure_ceiling_current"
            >
                <span class="label">Total Expended</span>
                            <input
                    class="detail"
                    readonly="readonly"
                    t-att-value="env.pos.format_currency(props.partner.expenditure_ceiling_current_total_sale_amount)"
                />
            </div>
            <div
                class="partner-detail"
                t-if="props.partner.expenditure_ceiling_current"
            >
                <span class="label">Start Date</span>
                            <input
                    class="detail"
                    readonly="readonly"
                    t-att-value="env.pos.format_date_fr(props.partner.expenditure_ceiling_current_period_start_date)"
                />
            </div>
            <div
                class="partner-detail"
                t-if="props.partner.expenditure_ceiling_current"
            >
                <span class="label">End Date</span>
                            <input
                    class="detail"
                    readonly="readonly"
                    t-att-value="env.pos.format_date_fr(props.partner.expenditure_ceiling_current_period_end_date)"
                />
            </div>
        </xpath>
    </t>

</templates>
