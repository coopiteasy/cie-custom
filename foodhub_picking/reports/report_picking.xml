<odoo>
    <template id="report_picking" inherit_id="stock.report_picking">
        <xpath expr="//div[@name='div_origin']/strong" position="before">
            <strong>Picking:</strong>
        </xpath>
        <xpath expr="//div[@name='div_origin']/strong[2]" position="attributes">
             <attribute name="class">invisible</attribute>
        </xpath>
        <xpath expr="//div[@name='div_origin']/p" position="attributes">
            <attribute name="t-field">o.name</attribute>
        </xpath>
        <xpath expr="//h1" position="attributes">
            <attribute name="t-field">o.origin</attribute>
        </xpath>
        <xpath expr="//th[@name='th_product']" position="before">
                <th>
                    <strong>Category</strong>
                </th>
        </xpath>

        <xpath
            expr="//span[@t-field='ml.product_id.display_name']/.."
            position="before"
        >
                <td>
                    <span t-field="ml.product_category_name" />
                </td>
        </xpath>
    </template>
        <template
        id="report_delivery_document"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//div[@name='div_origin']/strong" position="before">
            <strong>Picking:</strong>
        </xpath>
        <xpath expr="//div[@name='div_origin']/strong[2]" position="attributes">
             <attribute name="class">invisible</attribute>
        </xpath>
        <xpath expr="//div[@name='div_origin']/p" position="attributes">
            <attribute name="t-field">o.name</attribute>
        </xpath>
        <xpath expr="//span[@t-field='o.name']" position="attributes">
            <attribute name="t-field">o.origin</attribute>
        </xpath>
        <xpath expr="//th[@name='th_sm_product']" position="before">
                <th>
                    <strong>Category</strong>
                </th>
        </xpath>

        <xpath expr="//span[@t-field='move.product_id']/.." position="before">
                <td>
                    <span t-field="move.product_category_name" />
                </td>
        </xpath>
    </template>
</odoo>
