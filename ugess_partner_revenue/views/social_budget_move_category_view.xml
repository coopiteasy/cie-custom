<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="social_budget_move_category_action" model="ir.actions.act_window">
        <field name="name">Social Budget Move Categories</field>
        <field name="res_model">social.budget.move.category</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem
        id="social_budget_move_category_menu"
        name="Money Flow Categories"
        action="social_budget_move_category_action"
        parent="contacts.res_partner_menu_config"
    />

    <record id="social_budget_move_category_view_tree" model="ir.ui.view">
        <field name="name">view_social_budget_move_category_tree</field>
        <field name="model">social.budget.move.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="type" />
            </tree>
        </field>
    </record>

    <record id="social_budget_move_category_view_form" model="ir.ui.view">
        <field name="name">view_social_budget_move_category_form</field>
        <field name="model">social.budget.move.category</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="type" />
                    <field name="name" />
                </group>
            </form>
        </field>
    </record>
</odoo>
