<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res_partner_view_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <page name="personal_information_page" position="after">
                <page
                    string="Social Budget"
                    name="page_social_budget"
                    attrs="{'invisible': [('is_company', '=', True)]}"
                    groups="ugess_partner_revenue.group_ugess_partner_revenue_user"
                >
                <group>
                <group>
                    <field name="total_income" />
                    <field name="total_expenditure" />
                </group>
                <group>
                    <field name="monthly_savings_per_person" />
                    <field name="daily_savings_per_person" />
                </group>
                </group>
                <group name="group_social_budget" />
                <field name="social_budget_move_ids">
                        <tree
                            string="Social Budget"
                            name="tree_social_budget"
                            editable="bottom"
                        >
                            <field name="type" invisible="True" />
                            <field name="category_id" />
                            <field
                                name="expenditure"
                                attrs="{'readonly': [('type','!=','expenditure')], 'required':[('type','=','expenditure')]}"
                            />
                            <field
                                name="income"
                                attrs="{'readonly': [('type','!=','income')], 'required':[('type','=','income')]}"
                            />
                        </tree>
                    </field>

                </page>

            </page>
        </field>
    </record>


</odoo>
