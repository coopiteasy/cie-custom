<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="membership_extension.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information_page']" position="after">
                <xpath expr="//page[@name='membership']" position="move" />
            </xpath>
            <xpath expr="//field[@name='member_lines']/tree" position="attributes">
                <attribute name="create">false</attribute>
            </xpath>
            <xpath expr="//div[field[@name='membership_state']]" position="after">
                <field name="expenditure_ceiling_current" />
                <field name="expenditure_ceiling_current_remaining_amount" />
            </xpath>
            <xpath
                expr="//field[@name='member_lines']/tree//field[@name='state']"
                position="after"
            >
                <field name="social_project_id" optional="hide" />
                <field name="social_project_type_id" optional="show" />
                <field name="expenditure_ceiling" widget="monetary" optional="show" />
                <field name="expenditure_ceiling_period" optional="show" />
                <field name="currency_id" invisible="1" />
            </xpath>
            <xpath expr="//page[@name='membership']//div/button" position="attributes">
                <attribute name="context">{'default_partner_id': active_id}</attribute>
            </xpath>
            <!-- membership_line form modifications -->
            <xpath
                expr="//field[@name='member_lines']/form//field[@name='date_from']/../.."
                position="after"
            >
                <group>
                    <group>
                        <field name="partner" invisible="1" />
                        <field
                            name="social_project_id"
                            context="{'default_partner_id': partner, 'invisible_partner': True}"
                            options="{'no_quick_create' : True}"
                        />
                        <field name="comment" />
                    </group>
                    <group>
                        <label for="expenditure_ceiling" />
                        <div class="o_row">
                            <field name="expenditure_ceiling" widget="monetary" />
                            <p>per</p>
                            <field name="expenditure_ceiling_period" />
                        </div>
                    </group>
                </group>

                <label for="expenditure_override_ids" />
                <field name="expenditure_override_ids">
                    <tree editable="bottom">
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="expenditure_ceiling" />
                    </tree>
                </field>
                <field name="currency_id" invisible="1" />
            </xpath>
            <xpath expr="//notebook/page[last()]" position="after">
                <page
                    string="Technical"
                    name="page_technical"
                    groups="base.group_system"
                >
                    <group>
                        <field name="current_membership_line_id" />
                        <field name="expenditure_ceiling_current_period_start_date" />
                        <field name="expenditure_ceiling_current_period_end_date" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
