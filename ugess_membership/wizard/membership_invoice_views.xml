<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_invoice_view" model="ir.ui.view">
        <field name="name">membership.invoice.view.form</field>
        <field name="model">membership.invoice</field>
        <field name="inherit_id" ref="membership.view_membership_invoice_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']/.." position="after">
                <group col="2">
                    <group>
                        <field name="partner_id" invisible="1" />
                        <!--
                            no_quick_create disables 'Create
                            "text_you_just_entered"' on the dropdown. This
                            is needed because that option somehow breaks—type_id
                            is required, but is not set, and this causes Odoo to
                            raise an error.
                        -->
                        <field
                            name="social_project_id"
                            context="{'default_partner_id': partner_id, 'invisible_partner': True}"
                            options="{'no_quick_create' : True}"
                        />
                        <field name="comment" />
                    </group>
                    <group>
                        <label for="expenditure_ceiling" />
                        <div class="o_row">
                            <!--
                                FIXME: Currency symbol is not shown for any of
                                the monetary widgets.
                            -->
                            <field name="expenditure_ceiling" widget="monetary" />
                            <p>per</p>
                            <field name="expenditure_ceiling_period" />
                        </div>
                    </group>
                </group>

                <label for="expenditure_override_ids" />
                <field name="expenditure_override_ids">
                    <tree editable="bottom">
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="expenditure_ceiling" />
                    </tree>
                </field>
                <field name="currency_id" invisible="1" />
            </xpath>
        </field>
    </record>

    <!--
        At UGESS we want to see the dates also when they are fixed
    -->
    <record id="view_membership_custom_date_invoice_view" model="ir.ui.view">
        <field name="name">membership.invoice.view.form</field>
        <field name="model">membership.invoice</field>
        <field
            name="inherit_id"
            ref="membership_custom_date.view_membership_invoice_view"
        />
        <field name="arch" type="xml">
            <field name="date_from" position="after">
                <field
                    name="current_membership_date_from"
                    force_save="1"
                    attrs="{
                    'invisible': [('product_id_type', '=', 'custom')],
                }"
                />
            </field>
            <field name="date_to" position="after">
                <field
                    name="current_membership_date_to"
                    force_save="1"
                    attrs="{
                    'invisible': [('product_id_type', '=', 'custom')],
                }"
                />
            </field>
        </field>
    </record>

</odoo>
