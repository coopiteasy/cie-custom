<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority">25</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contact_addresses']" position="before">
                <xpath
                    expr="//page[@name='personal_information_page']"
                    position="move"
                />
            </xpath>
            <xpath expr="//page[@name='personal_information_page']" position="after">
                <xpath expr="//page[@name='household']" position="move" />
            </xpath>
            <xpath expr="//page[@name='household']" position="after">
                <xpath expr="//page[@name='social_project']" position="move" />
            </xpath>
            <xpath expr="//page[@name='social_project']" position="after">
                <xpath expr="//page[@name='page_social_budget']" position="move" />
            </xpath>
            <xpath expr="//page[@name='page_social_budget']" position="after">
                <xpath expr="//page[@name='membership']" position="move" />
            </xpath>
        </field>
    </record>

</odoo>
