<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="cron_recompute_household_member_age" model="ir.cron">
        <field name="name">Household Member: Recompute Age</field>
        <field name="model_id" ref="model_household_member" />
        <field name="state">code</field>
        <field name="code">model.cron_compute_age()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
        <field
            name="nextcall"
            eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"
        />
    </record>
</odoo>
